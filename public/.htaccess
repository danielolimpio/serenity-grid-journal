RewriteEngine On
RewriteBase /

# Garante index.html como arquivo padrão de diretórios
DirectoryIndex index.html

# Evita content-negotiation atrapalhar URLs "bonitas"
Options -MultiViews

# Cache: evita HTML/CSS presos em cache após deploy (Hostinger costuma ser agressivo)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Força HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Se a URL é um diretório existente e NÃO termina com barra → redireciona com barra
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ $1/ [R=301,L]

# Se a URL é um diretório existente e termina com barra → serve index.html dele
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)/$ $1/index.html [L]

# Se a URL aponta diretamente para um arquivo existente → serve-o
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# IMPORTANTE: NÃO há fallback para SPA - se não existe, retorna 404
