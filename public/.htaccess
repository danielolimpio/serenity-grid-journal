RewriteEngine On
RewriteBase /

# Garante index.html como arquivo padrão de diretórios
DirectoryIndex index.html

# Evita content-negotiation atrapalhar URLs “bonitas”
Options -MultiViews

# Força HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Redireciona para barra final APENAS quando o destino é um diretório real
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ $1/ [R=301,L]

# Serve index.html para qualquer pasta que exista (SSG)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)/$ $1/index.html [L]
